# Copy to .env.cloud, separate from the local .env. Never commit real values.
# Workshop/AWS settings are inherited from the VDI environment. No need to copy
# them here. Only uncomment these overrides when using another machine.
# AWS credentials are refreshed by the supplied setup-participant.sh.
# EVENT_ID=replace-with-workshop-event
# PARTICIPANT_ID=replace-with-participant-id
# PARTICIPANT_CODE=replace-with-participant-code
# PARTICIPANT_URL=https://workshop-provided-endpoint
# AWS_REGION=us-east-1
# AWS_EXPECTED_ACCOUNT_ID=123456789012

IS_LOCAL=false
# Generate once: python3.13 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Reuse this same key on subsequent deployments; changing it invalidates JWTs.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# CloudFront serves frontend and API on one origin, so CORS isn't required.
# Optional explicit HTTPS origin for intentional cross-origin browser access:
# FRONTEND_ORIGIN=https://example.cloudfront.net

# Aurora credentials are created by Terraform. Do not put DATABASE_URL or
# POSTGRES_* here: database maintenance reads the deployed Lambda configuration.
# The WorkSpace/runner must have VPC connectivity and existing PostgreSQL access.
# Lambda and Aurora reuse the workshop security group without changing its rules.
# The VPC is discovered from the participant security group. Optional override:
# TF_VAR_aws_vpc_id=vpc-0123456789abcdef0

# Only needed for `database --seed` and the optional authenticated smoke check.
# Each must have 12–128 nonblank characters. Existing passwords aren't overwritten.
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
SEED_ENGINEER_PASSWORD=
