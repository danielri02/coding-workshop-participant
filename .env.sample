# Copy to .env in the repository root. Shared by backend, frontend and deployment.
# Existing shell variables override this file. Values are literal, without ${...}
# interpolation. Use quotes around passwords containing spaces or # characters.
IS_LOCAL=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASS=postgres123

# Optional full URL: takes precedence over every POSTGRES_* connection component.
# DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/postgres?sslmode=disable

# Optional host alias for the SAME server as POSTGRES_HOST, as seen from Lambda.
# Loopback hosts automatically use 172.17.0.1 on Linux, host.docker.internal otherwise.
# POSTGRES_LAMBDA_HOST=172.17.0.1

FRONTEND_ORIGIN=http://localhost:3000
# JWT_SECRET_KEY=replace-with-at-least-32-bytes-if-you-override-the-local-default
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Required only to create the demo employee/engineer accounts. The development
# admin remains admin@acme.inc / admin. Existing seeded credentials are preserved.
SEED_PASSWORD=development-only

# Public frontend settings. Workshop-generated Lambda URLs are read automatically
# from frontend/.env.local; leave the URL/mapping unset here in workshop mode.
VITE_API_MODE=workshop
# For a directly running FastAPI process, override BOTH settings below:
# VITE_API_MODE=direct
# VITE_API_URL=http://localhost:8000
